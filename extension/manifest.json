{
  "manifest_version": 3,
  "name": "花瓣原图下载器",
  "description": "整板原图下载、暂停继续、逐张校验；与本地下载引擎配合使用。",
  "version": "1.1.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab"
